# Backend runtime configuration. Keep real values in the hosting provider secret store.
DATABASE_URL=<postgres-connection-string>
JWT_SECRET=<long-random-secret>
EMAILJS_SERVICE_ID=<email-service-id>
EMAILJS_TEMPLATE_ID=<email-template-id>
EMAILJS_PUBLIC_KEY=<email-public-key>
EMAILJS_PRIVATE_KEY=<email-private-key>
EMAILJS_TIMEOUT_MS=30000
PORT=3000
