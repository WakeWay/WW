{
  "expo": {
    "name": "WakeWay",
    "slug": "wakeway-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/WakeWay_log.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/WakeWay_log.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "buildsUsingCM": false,
      "bundleIdentifier": "com.nadendla.wakewayapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to track your arrival",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to track your arrival even when the app is in the background",
        "UIBackgroundModes": [
          "location",
          "location"
        ]
      }
    },
    "android": {
      "package": "com.nadendla.wakewayapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/WakeWay_log.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow WakeWay to use your location to notify you when you're near your stop"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/WakeWay_log.png",
          "color": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b3ca0b48-b637-421d-a685-d4513647fa4c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b3ca0b48-b637-421d-a685-d4513647fa4c"
    }
  }
}
